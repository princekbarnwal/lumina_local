generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  shops Shop[] // 👈 ADD THIS
}

model Shop {
  id      Int    @id @default(autoincrement())
  name    String
  ownerId Int

  owner    User      @relation(fields: [ownerId], references: [id])
  products Product[] // 👈 ADD THIS
}

model Product {
  id     Int    @id @default(autoincrement())
  name   String
  shopId Int

  shop    Shop     @relation(fields: [shopId], references: [id])
  reviews Review[]
}

model Review {
  id             Int      @id @default(autoincrement())
  productId      Int
  userIdentifier String
  rating         Int
  comment        String?
  sentiment      String?
  createdAt      DateTime @default(now())
  trustScore     Float    @default(1.0)
  isSpam         Boolean  @default(false)

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, userIdentifier])
}

model Sentiment {
  id        Int    @id @default(autoincrement())
  reviewId  Int
  sentiment String
}

model InsightReport {
  id             Int       @id @default(autoincrement())
  scope          String
  scopeId        Int
  reviewCount    Int
  latestReviewAt DateTime?
  report         Json
  source         String
  prompt         String?
  model          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([scope, scopeId])
}

model DailyMetrics {
  id            Int      @id @default(autoincrement())
  scope         String
  scopeId       Int
  date          DateTime
  avgRating     Float
  reviewCount   Int
  positiveCount Int
  neutralCount  Int
  negativeCount Int
  createdAt     DateTime @default(now())

  @@unique([scope, scopeId, date])
}
